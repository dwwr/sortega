{
  "manifest_version": 3,
  "name": "Sortega",
  "version": "0.1.0",
  "description": "Swipe through bookmarks like a deck — file into a folder or delete.",
  "permissions": ["bookmarks", "storage", "tabs"],
  "action": {
    "default_title": "Sortega — swipe bookmarks",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sortega@local.dev",
      "strict_min_version": "121.0"
    }
  }
}
